## 第一章：ECHO LOBBY —— 现代写字楼大堂
## 挂载节点类型: 无（extends RefCounted，静态 build() 返回 ChapterData）
## 视觉目标（用户要求「照片级 + 现代风格 + 不灰暗」）:
##   白色抛光石材 + 深色石材导视带 + 玻璃幕墙 + 铝质吊顶灯带。
##   这是「当代企业总部大堂」的通用视觉语言，靠材质对比与光斑层次出画面，
##   而不是靠堆贴图细节 —— 参考项目的 WhiteWall 本来就是低对比度纯色墙，
##   它的照片感来自「大面纯色 + 局部高光 + 干净接缝」。
## 布局（22 宽 x 46 长 x 3.6 高）:
##   - 中央 2.6 米宽的通行动线，两侧各一排 1.1x1.1 方柱
##   - 左墙（x=-11）是玻璃幕墙，透过玻璃看到落日天空
##   - 右墙（x=+11）是白墙 + 自动售货机 + 储物柜，形成"室内街景"
##   - 远端（z=-23）是前台与双开门，作为视觉焦点
extends RefCounted

const K := preload("res://scripts/level/chapter_kit.gd")
## 道具层（左墙幕墙 / 右墙街景）。单向依赖：props 不反向引用本文件。
const P := preload("res://scripts/level/chapter_01_props.gd")

## 大厅尺寸常量。改这里就能整体缩放，不用逐条改坐标。
const W := 22.0        # X 向宽度
const L := 46.0        # Z 向长度
const H := 3.6         # 净高
const HALF_W := 11.0
const HALF_L := 23.0

static func build() -> ChapterData:
	var d := ChapterData.make("chapter_01", "ECHO LOBBY", "NEO-TOKYO · CORPORATE ATRIUM")
	d.objective = "CLEAR THE LOBBY"
	d.mesh_step = 1.0
	# 冷白环境光。数值经 tmp/lightscan_runner.tscn 参数扫描标定（14/16 分）：
	# energy=3.2 / range=6.0 / amb=0.40 → 地板 0.916、两灯间 0.646、光斑对比 0.27。
	# 旧值 0.66 会让地板叠到 1.000 削顶，贴图细节全丢。
	d.with_ambient(Color(0.40, 0.41, 0.43), Color(0.20, 0.196, 0.192))
	# 后期：亮度略提、对比略降，避免"阴间滤镜"（用户明确说不要太灰暗）。
	# brightness 必须留在 1.0 附近 —— 着色器里 col *= brightness 是全局乘法，
	# 会先把 >1/brightness 的部分截断再量化。早前探针没挂后期，用 1.18 补偿假暗，
	# 后期一接上就二次叠加：天花 15.92% 像素烧成纯白（tmp/Audit.cs 实测）。
	# 现在明度由烘焙提供（HORIZON_GAIN 0.95 + LIGHT_GAIN 5.2），后期只做调色。
	# palette_levels / dither_strength 必须显式覆盖：着色器默认 8.0 / 1.0，
	# 审核员实测 480x270 下产生可见色阶断层与 1px 棋盘噪声 ——
	# 04_left 纯红像素（B==0）12749 px 占画面 10.82%，幕墙天空格内 sd 仅 19.2~26.1，
	# 天空 B 通道从贴图 0.224 掉到 0.067（剩 30%）。24 阶 + 0.45 抖动后中调才连续。
	# curvature 必须显式置 0：默认 0.06 让画面上下各被吃掉约 3.7% 屏高成纯黑硬边。
	# chromatic_aberration 降到 0.35：默认 1.0 在地板每 3~5px 出现单通道 ±30 的彩边。
	# 二轮标定（tmp/Audit.cs 实测）：tint 死值全部修掉后 ch01 是四章里最暗的一章
	#   —— 00_player lum 0.483 / 03_right 0.411 / 05_top sat 0.038，
	#   而 ch02 是 0.594、ch03 是 0.560。白石材主导的画面饱和度天然低，
	#   所以亮度提到 1.10（此时 ceiling 0.70 × 1.10 = 0.77，离 1.0 还有余量，
	#   不会再出现早期 tint 1.30 叠加造成的 white=15.92%），
	#   饱和度提到 1.20 让石材的冷灰偏蓝能被读出来（纯中性白在像素量化下就是灰）。
	d.with_post({
		"brightness": 1.10, "contrast": 1.06, "saturation": 1.20,
		"lift": 0.051, "vignette_strength": 0.14, "scanline_strength": 0.06,
		"palette_levels": 12.0, "dither_strength": 0.18,
		"curvature": 0.0, "chromatic_aberration": 0.35,
	})
	d.with_player(Vector3(0.0, 0.0, 18.0), 0.0)

	_shell(d)
	_columns(d)
	_ceiling(d)
	# 两面侧墙（幕墙 + 室内街景）拆到 chapter_01_props.gd：
	# PDF 硬红线单文件 ≤ 300 行，补齐审核修正后本文件涨到 333 行。
	# 侧墙是全章密度最高的两块内容（幕墙 30 分格 + 售货机/储物柜/踢脚线），
	# 各自带十几行实测注释，独立成文件后两层都能继续长注释而不撞线。
	P.left_curtain(d)
	P.right_wall(d)
	_reception(d)
	_spawns(d)
	_waves(d)
	return d

## 地面 / 天花 / 四面墙。用 panel 而不是 box：
## 站在房间内部看 box 的内表面是背面，会被 cull 掉变成透明的；
## panel 的法线朝内，才是"看得见的墙"。
static func _shell(d: ChapterData) -> void:
	# 地面：白色抛光瓷砖，中间嵌一条深色导视带。
	# tint 从纯中性白 (1,1,1) 改成偏冷 (0.93,0.97,1.0)：
	#   tmp/Audit.cs 实测 ch01 四机位 sat 只有 0.038~0.097，而 ch02 是 0.169、ch03 是 0.162。
	#   根因不是后期饱和度不够，而是画面主体（地面/天花/柱身/墙面）全是同一种中性白，
	#   没有任何色相差可放大 —— 只调 saturation 只会把 dither 噪点的彩边一起放大。
	#   中性白在 24 阶量化下就是"灰"，必须让大面材质本身带一点冷色偏，
	#   才读得出"抛光石材反着天光"，这也是现代商业空间的真实观感。
	d.add(K.panel(Vector3(0.0, 0.0, 0.0), Vector2(W, L), "up", "CeramicFloor_White",
		Color(0.93, 0.97, 1.0)))
	# 中轴导视带：深色石材，与白石地面拉开层次。
	# 关键实测（01_idle.png，x=236 竖条 vs x=150 地砖）：
	#   CeramicFloor_Gray(#7B7B7B) tint 0.78 → rgb(74) / 地砖 230，比值 0.32 —— 读成地板裂缝
	#   同一材质 tint 1.06 / 1.42 / 1.72 → **三次渲染值逐字节相同 rgb(98)**
	#   判定性实验（tint 3.0,0,0 渲染出 rgb(106,0,0)）证明：**顶点色在 1.0 处硬截断**，
	#   任何 >1.0 的 tint 都是死值。想比材质本身更亮只能换更亮的材质，不能抬 tint。
	# 正解：CeramicFloor_White(#EBEAEB, 0.92) × tint 0.60 ≈ 反照率 0.55，
	#   与地面 lit≈0.86 相乘得 rgb(120)，与白石地面比值 0.60 —— 深石材而非黑洞。
	d.add(K.panel(Vector3(0.0, 0.012, 0.0), Vector2(2.6, L), "up", "CeramicFloor_White",
		Color(0.60, 0.62, 0.66), 0.25))
	# 地面铺装缝：4x4 米石材分格。贴图自带砖缝在 480x270 下被 mipmap 抹平，
	# 整片 22x46 米白石材读成"一块白塑料"，没有任何尺度参照物 —— 大堂的
	# 纵深感只能靠柱子和灯槽给，地面本身是平的（审核 P1「地面无铺装缝」）。
	# tint 0.58：0.70 在首轮实测里几乎看不见（砖面 0.93 vs 缝 0.70 只有 25% 差，
	# 经过 24 阶量化 + dither 后差不到 2 级）。0.58 与导视带 0.60 同档，
	# 读成"石材之间的填缝"而不是黑色描线；宽 0.04 米在 1.6 米眼高下近处约
	# 3 像素、远处自然收敛。
	d.add(K.floor_seams(Vector3(0.0, 0.0, 0.0), Vector2(W, L), 4.0,
		"CeramicFloor_White", Color(0.58, 0.60, 0.64), 0.05))
	# 天花：白色铝扣板。
	# tint 1.30 → 1.04 → 0.88。1.30 是"探针没挂后期"时代的补偿值，后期接上后变成
	# 二次叠加，整片天花被烧到纯白（white=15.92%）。
	# 0.99 → 0.88 的依据（灯槽 AO 修好后的实测）：
	#   灯槽原来被当 AO 遮挡物，把天花压到 0.583 倍（暗斑 113 vs 灯间 220）。
	#   修掉后天花带 y=20..80 均值从 0.66 升到 0.89，而行内 max 触到 1.000
	#   （y=60 white=9.6%）—— 白铝扣板该有的明度是 0.78~0.82，0.89 已经开始烧细节。
	#   0.88 使天花带回落到 0.79，仍比地面 0.75 略亮（灯槽离天花只有 0.35 米，
	#   近距离照射必然更亮），但留住了分缝格栅与灯槽的层次。
	d.add(K.panel(Vector3(0.0, H, 0.0), Vector2(W, L), "down", "WhiteCeiling",
		Color(0.88, 0.88, 0.89)))
	# 吊顶分缝格栅：WhiteCeiling 几乎纯白且细节极少，22x46 米整片铺开再被
	# mipmap 抹平后读成"一团模糊云雾"。铺两向格栅把天花切成 4x4 米的板，
	# 才读得出"这是装出来的吊顶"。
	# 材质 MetalPlateWall → WhiteCeiling、tint 0.62 → 0.92、drop 0.09 → 0.05：
	#   审核员实测梁亮度只有 0.21~0.28，而吊顶 0.66~0.74 —— 梁比吊顶暗 2.5~3.1 倍，
	#   在画面上形成横贯全宽的粗黑带（y=81..84 mean 60~88，邻行 130~153）。
	#   根因是梁底吃不到 down_only 直射（_hemisphere 在 dy=+0.115 只给 0.31），
	#   再乘 MetalPlateWall 的 0.611 与 tint 0.62 就只剩 0.24。
	#   白铝扣板吊顶的分缝梁本该是同色浅压条，不是深色金属条。
	# 0.92 → 0.84 → 0.70：0.84 与吊顶 0.88 只差 4.5%，实测在 480x270 下完全看不见，
	#   天花仍是"一整片白"，审核 P1「格栅梁不可见（相对对比度 7.5~10.9%）」未解决。
	#   0.70 给出 20% 相对对比度，梁才读得出是梁 —— 但也不能再低，
	#   深色金属条在天花上会读成"脏污"。
	d.add(K.ceiling_grid(Vector3(0.0, H - 0.03, 0.0), Vector2(W, L), "z", 4.0,
		0.05, "WhiteCeiling", Color(0.70, 0.70, 0.72)))
	d.add(K.ceiling_grid(Vector3(0.0, H - 0.03, 0.0), Vector2(W, L), "x", 6.0,
		0.05, "WhiteCeiling", Color(0.70, 0.70, 0.72)))
	# 四面墙
	d.add(K.panel(Vector3(0.0, H * 0.5, -HALF_L), Vector2(W, H), "z+", "WhiteWall",
		Color(1.0, 1.0, 1.0)))
	d.add(K.panel(Vector3(0.0, H * 0.5, HALF_L), Vector2(W, H), "z-", "WhiteWall",
		Color(0.92, 0.93, 0.95)))
	d.add(K.panel(Vector3(HALF_W, H * 0.5, 0.0), Vector2(L, H), "x-", "WhiteWall",
		Color(0.97, 0.97, 0.98)))
	# 墙面挂板分缝：WhiteWall 平均色 #C4C4C4 且几乎无花纹，22x46 米整面铺开
	# 在近景读成"一整片白灰"。审核实测 ch01 右墙近景上半 0.403~0.546、全帧最暗，
	# 但问题不是亮度而是**没有任何东西可看**。真实现代大堂的墙是石材挂板，
	# 靠竖向分缝给出 1.2 米模数 —— 这条缝同时给近景一个尺度参照。
	# 1.2 米是石材挂板的真实模数；tint 0.62 比墙面 0.97 深一档，读成"板与板的
	# 接缝"而不是画上去的线。前后端墙（z=±HALF_L）离玩家 20~40 米，
	# 分缝在 480x270 下不足 1 像素，只给两侧长墙铺。
	d.add(K.wall_seams(Vector3(HALF_W, H * 0.5, 0.0), Vector2(L, H), "x-", 1.2,
		"WhiteWall", Color(0.62, 0.63, 0.66), 0.03))
	# 左墙留作幕墙，这里只铺 0.9 米高的墙裙，上面全是玻璃
	d.add(K.panel(Vector3(-HALF_W, 0.45, 0.0), Vector2(L, 0.9), "x+", "WhiteWall_Bottom_Blue",
		Color(0.86, 0.90, 0.96)))

## 两排方柱。柱子是"照片感"的关键：它给出纵深节奏与光斑落点，
## 也让 46 米的长厅不至于一眼望到底的空旷。
static func _columns(d: ChapterData) -> void:
	var z: float = -18.0
	while z <= 18.0:
		for sx: float in [-1.0, 1.0]:
			var x: float = sx * 6.4
			# 柱身：白色石材。step=0.4 —— 柱子只有 1.1 米宽，用默认 1.0 米步长时
			# 每个面只有 2x4 个顶点，顶点色被 Gouraud 插值抹成连续渐变，
			# 四条竖棱糊掉，实测读成"一根金属圆柱"而不是方柱。
			# tint 1.35 → 1.02：AO 修好「朝上的面被头顶格栅误压」后，
			# 柱面 lit 从 0.434 回到 0.916（tmp/spot_runner.tscn 实测），
			# 再乘 1.35 会直接顶到 1.0 烧白。1.02 时 0.916×1.02×#BDBDBD(0.741) ≈ 0.69。
			d.add(K.box(Vector3(1.1, H, 1.1), Vector3(x, H * 0.5, z), "WhiteWall_Column",
				Color(0.98, 0.98, 0.97), true, 1.0, 0.4))
			# 柱础：深色石材，给柱子"落地感"，否则像悬空的方筒。
			# 材质 CeramicFloor_Gray → CeramicFloor_White、tint 0.62 → (0.45,0.47,0.50)：
			#   旧链路 CeramicFloor_Gray 反照率 0.483 × tint 0.62 = 0.30，
			#   再乘 AO 0.55 与接触阴影 0.60 = 0.099 ≈ 25/255，实测柱础
			#   mean=0.163 min=0.000（直方图里 (29,29,29) 出现 50 次、(0,0,0) 23 次），
			#   比同柱柱身 mean=0.558 暗 3.4~4.1 倍 —— 读成"柱子插进黑洞"。
			#   换亮材质 + 深 tint 才能得到"深灰石材"而不是"纯黑"。
			d.add(K.box(Vector3(1.3, 0.28, 1.3), Vector3(x, 0.14, z), "CeramicFloor_White",
				Color(0.45, 0.47, 0.50)))
			# 柱顶：一圈深色压条，与吊顶脱开
			d.add(K.box(Vector3(1.24, 0.12, 1.24), Vector3(x, H - 0.06, z),
				"MetalWall", Color(0.72, 0.74, 0.78)))
		z += 9.0

## 吊顶：灯槽 + 每盏灯登记一个构建期光源（不产生节点）。
## 灯带朝向 -Y，用 WhiteCeiling_MetalEdge 的亮色 tint 冒充自发光。
static func _ceiling(d: ChapterData) -> void:
	# 灯槽必须比吊顶格栅低，否则两者在 y 上重合、格栅梁从灯槽里穿出来。
	# 审核员实测：ceiling_grid("z",4.0) 的梁 x=3.667 宽 0.10 → [3.617,3.717]
	#   完全落在灯槽 x∈[2.05,3.95] 内，且梁 y∈[3.515,3.605] 与灯槽 y∈[3.510,3.600]
	#   重合 —— 两个实体相交穿透。灯槽下沉到 H-0.14 后不再重叠。
	# 发光面同步改 (1.86,0.40)：旧 (1.7,0.34) 比灯槽 (1.9,0.44) 小一圈，
	#   四周露出 0.1 米金属槽底，在画面上形成一圈黑框
	#   （00_player x=123 竖剖面 y=54..58 掉到 0.19~0.34，前后都是 0.7~0.9）。
	# 灯位 z 从 -19.5 到 19.5 步长 6.5：旧序列 -19,-12.5,-6,0.5,7,13.5 在出生点
	#   z=18 处最近的灯在 4.5 米外，atten=(1-4.5/6)²=0.0625，其余 5 盏 0.0000，
	#   开局地面只有 0.448（对比 z=0.5 投影处 0.704，暗 36%）—— "出生就暗"。
	#   新序列最近灯 1.5 米，atten=0.5625。
	var z: float = -19.5
	while z <= 19.5:
		# 两排灯位：x=±3.0（走道上方）与 x=±7.6（靠墙侧）。
		# 单排 ±3.0 时墙面 x=11 距灯 8 米，超出 range 6.0 —— 墙 100% 只吃环境光，
		# 实测 ch01_03_right 全章最暗 lum=0.294、inner avg rgb(70,77,82)，
		# 白墙读成深灰墙。补一排靠墙灯后墙面距灯 3.4 米，落在 range 内。
		for spec: Array in [[-1.0, 3.0, 3.2], [1.0, 3.0, 3.2], [-1.0, 7.6, 2.6], [1.0, 7.6, 2.6]]:
			var x: float = float(spec[0]) * float(spec[1])
			var energy: float = float(spec[2])
			# 灯槽（深色铝框）。body=false：灯槽不该当 AO 遮挡物。
			# 依据（00_player 天花逐行采样实测，决定性）：
			#   天花在灯槽正上方掉到 113，而灯间区域 220 —— 差 107 灰阶，
			#   读成"吊顶上洒了一片脏斑"。按 fov75/480x270 反算，y=60 那行对应
			#   z=13.31，正是 z=13.0 那排灯槽；灯槽盒顶 y=3.505 距天花 0.095 米，
			#   AO 的 t=1-0.095/1.6=0.94、occ=0.885，k=1-0.55(1-e^-1.416)=0.583，
			#   0.583×220≈128 与实测 113 同量级 —— 就是灯槽盒在压自己的天花。
			#   物理上灯槽是贴在天花上的装饰件，它挡不住天花自己的环境光。
			d.add(K.box(Vector3(1.9, 0.09, 0.44), Vector3(x, H - 0.14, z),
				"MetalPlateWall", Color(0.58, 0.60, 0.64), false))
			# 发光面（emissive：跳过光照烘焙，否则会比周围天花还暗）
			d.add(K.panel(Vector3(x, H - 0.19, z), Vector2(1.86, 0.40), "down",
				"WhiteCeiling_MetalEdge", Color(1.0, 0.99, 0.94), 0.5, true, true))
			# 光源登记：暖白 4300K
			d.lamps.append(K.lamp(Vector3(x, H - 0.35, z),
				Color(1.0, 0.97, 0.90), energy, 6.0))
		z += 6.5
	# 中轴不放任何吊顶特征。
	# 依据（ch01_00_player 截帧，两次迭代）：
	#   ① 初版是一条 29 米连续长灯带 → 75° FOV 下从画面顶端直拉到消失点，
	#      读成"一条纯白竖线把画面从中间劈开"；
	#   ② 改成 3.9 米分段 + 2.5 米间隔后仍然是一条竖线 —— 因为玩家就站在中轴上，
	#      任何沿视线轴延伸的中轴特征都会投影成同一条屏幕竖线。这是透视的必然，
	#      不是参数问题，只能不放。
	#   两侧双排灯槽（上面的 while 循环）已经足够把视线引向远端，
	#   并且它们在画面上是两条汇聚的斜线，透视感比中轴线更强。

## 远端前台：大堂的视觉焦点。一块深色石材台面 + 背后发光 logo 墙。
static func _reception(d: ChapterData) -> void:
	# 前台位置 -HALF_L+1.6 = -21.4 → -16.0，并加宽 7.0 → 10.0。
	# 依据（审核员按 fov75/480x270 反算）：出生点 z=18、门 z=-22.84，距离 40.84 米，
	#   折 4.31 px/米 —— 台面 7.3 米只有 31 像素宽、门 2.3 米高只有 10 像素高，
	#   在大堂尽头缩成一个点，等于没有视觉焦点。
	#   移到 z=-16（24 米外、6.2 px/米）后台面约 64 像素、门高约 14 像素。
	var cz: float = -16.0
	# 台体深度 0.9 → 0.60、台面深度 1.05 → 0.70（审核 P0-1）：
	#   原台面 z∈[-16.525,-15.475]，双开门 z∈[-16.56,-16.44]，z 向重叠 0.085 米、
	#   y 向相交 0.09 米 —— 门 53.5% 的体积埋在台面里，正面看是一块被横切的板。
	#   收薄后门完全落在台面之后的净空里。
	d.add(K.box(Vector3(10.0, 1.1, 0.60), Vector3(0.0, 0.55, cz),
		"CeramicFloor_Gray", Color(0.70, 0.72, 0.76)))
	# 台面：更亮的石材，边缘略挑出
	d.add(K.box(Vector3(10.3, 0.09, 0.70), Vector3(0.0, 1.145, cz),
		"CeramicFloor_White", Color(1.0, 1.0, 1.0)))
	# 背景发光墙（朝 +Z），跟随前台上移
	d.add(K.panel(Vector3(0.0, 2.1, cz - 0.6), Vector2(11.0, 2.2), "z+",
		"WhiteWall_Dirty", Color(0.90, 0.94, 1.0)))
	d.lamps.append(K.lamp(Vector3(0.0, 2.2, cz + 0.8),
		Color(0.62, 0.84, 1.0), 1.1, 8.0))
	# 双开门（纯装饰，用 ExitDoor 材质贴面）
	# 厚度 0.12 → 0.08、z 从 cz-0.50 → cz-0.52（再往墙里退）、高 2.30 → 2.90：
	#   门顶 2.30 与发光墙顶 3.20 之间留 0.9 米空白，读成"门上方有个洞"。
	#   加高到 2.90 后门框与发光墙只差 0.3 米，才是正常的大堂双开门比例。
	d.add(K.box(Vector3(3.2, 2.90, 0.08), Vector3(0.0, 1.45, cz - 0.52),
		"ExitDoor", Color(1.0, 1.0, 1.0)))

## 刷怪点：两端 + 两侧柱间，距出生点 (0,18) 全部 ≥ 8 米。
static func _spawns(d: ChapterData) -> void:
	d.add_spawns([
		Vector3(0.0, 0.0, -19.0), Vector3(-4.0, 0.0, -19.0), Vector3(4.0, 0.0, -19.0),
		Vector3(0.0, 0.0, -12.0), Vector3(-8.5, 0.0, -12.0), Vector3(8.5, 0.0, -12.0),
		Vector3(-8.5, 0.0, -3.0), Vector3(8.5, 0.0, -3.0),
		Vector3(-8.5, 0.0, 6.0), Vector3(8.5, 0.0, 6.0),
		Vector3(-4.0, 0.0, 10.0), Vector3(4.0, 0.0, 10.0),
	])

## 五波，节奏从"稀疏试探"走到"贴脸压迫"。
static func _waves(d: ChapterData) -> void:
	d.wave(10, 8, 1.10, 0.00, 1.00, 1.00, 3.0, 4.0)
	d.wave(14, 12, 0.95, 0.12, 1.06, 1.12, 2.5, 4.0)
	d.wave(18, 16, 0.82, 0.20, 1.12, 1.24, 2.5, 3.5)
	d.wave(22, 20, 0.70, 0.28, 1.18, 1.36, 2.5, 3.5)
	d.wave(28, 24, 0.58, 0.36, 1.24, 1.50, 2.0, 0.0)
